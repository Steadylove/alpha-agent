# Dedicated Codex profile, verified by the synthetic native probe on Ubuntu 6.8/Docker 29.8.1.
# Base: Moby docker-v29.8.1 vendor/github.com/moby/profiles/apparmor/template.go
# SPDX-License-Identifier: Apache-2.0
abi <abi/4.0>,
include <tunables/global>
profile site-agent-native flags=(attach_disconnected,mediate_deleted) {
  include <abstractions/base>
  network,
  unix,
  deny network alg,
  deny network vsock,
  capability,
  file,
  userns,
  umount,
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (send,receive) peer=site-agent-native,
  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,
  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,
  ptrace (trace,tracedby,read,readby) peer=site-agent-native,

  # Replacement for blanket deny mount. All unlisted mounts remain denied.
  mount options=(rw,rslave) -> /,
  mount options=(rw,rslave,silent) -> /,
  mount fstype=tmpfs options=(rw,nosuid,nodev) -> /tmp/,
  mount options=(rw,rbind) /tmp/newroot/ -> /tmp/newroot/,
  mount options=(rw,rbind,silent) /tmp/newroot/ -> /tmp/newroot/,
  pivot_root oldroot=/tmp/oldroot/ /tmp/,
  mount options=(rw,rbind) /oldroot/proc/ -> /proc/,
  mount options=(rw,rbind,silent) /oldroot/proc/ -> /proc/,
  mount options=(rw,bind) /oldroot/{,**} -> /newroot/{,**},
  mount options=(rw,rbind) /oldroot/{,**} -> /newroot/{,**},
  mount options=(rw,bind,silent) /oldroot/{,**} -> /newroot/{,**},
  mount options=(rw,rbind,silent) /oldroot/{,**} -> /newroot/{,**},
  mount fstype=tmpfs options=(rw,nosuid,nodev) -> /newroot/{,**},
  mount fstype=proc options=(rw,nosuid,nodev,noexec) -> /newroot/proc/,
  mount fstype=devpts options=(rw,nosuid,noexec) -> /newroot/dev/pts/,
  remount options=(ro,bind) /newroot/{,**},
  remount options=(ro,bind,nosuid,nodev) /newroot/{,**},
  remount options=(ro,bind,nosuid,nodev,noexec) /newroot/{,**},
  remount options=(ro,nosuid,nodev,bind,silent,relatime) /newroot/{,**},
  remount options=(ro,nosuid,nodev,noexec,bind,silent,relatime) /newroot/{,**},
  remount options=(ro,nosuid,nodev,bind,silent) /newroot/{,**},
  # Workspace mode keeps only the approved workspace and Codex home writable.
  remount options=(rw,nosuid,nodev,bind,silent,relatime) /newroot/workspace/,
  remount options=(rw,nosuid,nodev,bind,silent,relatime) /newroot/tmp/codex-home/,
  mount options=(rw,rprivate) -> /oldroot/,
  mount options=(rw,rprivate,silent) -> /oldroot/,
  pivot_root oldroot=/newroot/ /newroot/,
}
