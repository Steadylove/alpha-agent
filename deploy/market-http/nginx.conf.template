server {
    listen 80;
    server_tokens off;
    gzip on;
    gzip_types text/plain text/csv application/json;
    gzip_min_length 256;
    client_max_body_size 8m;

    root /usr/share/nginx/html;
    location /telegram/ {
        proxy_pass http://telegram:8082/;
        proxy_http_version 1.1;
        proxy_read_timeout 30s;
        add_header Cache-Control "no-store";
    }
    location /desk/ {
        proxy_pass http://desk:8080/;
        proxy_http_version 1.1;
        add_header Cache-Control "no-store";
    }
    location /option-flow/ {
        proxy_pass http://option-flow:8083/;
        proxy_http_version 1.1;
        add_header Cache-Control "no-store";
    }
    location /compute/ {
        proxy_pass http://book:8081/;
        proxy_http_version 1.1;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        add_header Cache-Control "no-store";
    }
    location / {
        autoindex off;
        add_header Cache-Control "public, max-age=300";
        try_files $uri =404;
    }
}
