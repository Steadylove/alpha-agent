[Unit]
Description=Alpha Agent independent fundamental target valuation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
EnvironmentFile=-/var/lib/alpha-agent/daily-quant.env
Environment=TZ=Asia/Shanghai
ExecStart=/var/lib/alpha-agent/bin/alpha-fundamental.sh
WorkingDirectory=/var/lib/alpha-agent
Nice=15
TimeoutStartSec=3000
StandardOutput=append:/var/lib/alpha-agent/logs/fundamental.log
StandardError=append:/var/lib/alpha-agent/logs/fundamental.log
