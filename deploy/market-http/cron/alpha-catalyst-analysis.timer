[Unit]
Description=Refresh Catalyst commentary after daily data, afternoon and US premarket

[Timer]
OnCalendar=Tue..Sat *-*-* 10:05:00 Asia/Shanghai
OnCalendar=*-*-* 12:55:00 Asia/Shanghai
OnCalendar=Mon..Fri *-*-* 08:55:00 America/New_York
Persistent=true
AccuracySec=1min
Unit=alpha-catalyst-analysis.service

[Install]
WantedBy=timers.target
