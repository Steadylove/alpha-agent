generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum InstrumentType {
  STOCK
  ETF
  INDEX
}

enum WatchlistStatus {
  FOCUS
  NEW
  WATCH
  DOWNGRADED
}

enum JobStatus {
  SUCCESS
  FAILED
  PARTIAL
}

model Instrument {
  id        String         @id @default(cuid())
  symbol    String         @unique
  name      String
  type      InstrumentType
  sector    String?
  industry  String?
  exchange  String?
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  bars       DailyBar[]
  scores     StockScore[]
  states     WatchlistState[]
  sectorRows SectorScore[] @relation("SectorInstrument")
}

model DailyBar {
  id           String     @id @default(cuid())
  instrumentId String
  date         DateTime
  open         Float
  high         Float
  low          Float
  close        Float
  volume       BigInt
  source       String
  createdAt    DateTime   @default(now())

  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([instrumentId, date])
  @@index([date])
}

model MarketMetric {
  id         String   @id @default(cuid())
  date       DateTime
  mss        Float
  skewScore  Float?
  pcrScore   Float?
  creditScore Float?
  breadthScore Float?
  confidence Float
  details    Json
  createdAt  DateTime @default(now())

  @@unique([date])
}

/// MPR 宏观相变雷达的每日快照。
/// 只存展示与事件检测需要的字段；sigma 分级可由 dom* 推出，transDepth 可由 pathId 推出，故不落库。
model MacroPhaseState {
  id              String   @id @default(cuid())
  date            DateTime @unique
  pathId          Int
  fsmState        Int
  marketRiskScore Float
  prob5dDown      Float
  f1              Float
  f2              Float
  f3              Float
  f4              Float
  f5              Float
  rawTerm         Float
  rawCred         Float
  domVol          Float
  domCred         Float
  domSpot         Float
  spyDamage       Float
  leadGap         Float
  leadPersist     Int
  leadQuality     Float
  transVel        Float
  createdAt       DateTime @default(now())

  @@index([date])
}

model SectorScore {
  id           String   @id @default(cuid())
  date         DateTime
  instrumentId String
  symbol       String
  name         String
  rs21         Float
  rs63         Float
  score        Float
  rank         Int
  createdAt    DateTime @default(now())

  instrument Instrument @relation("SectorInstrument", fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([date, symbol])
  @@index([date, rank])
}

model StockScore {
  id             String   @id @default(cuid())
  date           DateTime
  instrumentId   String
  symbol         String
  finalCompassScore Float
  qualityScore   Float
  momentumScore  Float
  trendScore     Float
  fundamentalScore Float
  valuationScore Float
  environmentScore Float
  executionScore Float
  killSwitchStatus String
  killSwitchReason String?
  rank           Int
  status         WatchlistStatus
  details        Json
  createdAt      DateTime @default(now())

  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([date, symbol])
  @@index([date, rank])
}

model WatchlistState {
  id           String          @id @default(cuid())
  date         DateTime
  instrumentId String
  symbol       String
  previous     WatchlistStatus?
  current      WatchlistStatus
  reason       String
  createdAt    DateTime        @default(now())

  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([date, symbol])
  @@index([date, current])
}

model Report {
  id        String   @id @default(cuid())
  date      DateTime @unique
  title     String
  summary   String
  body      String
  version   String
  createdAt DateTime @default(now())
}

model NewsItem {
  id             String   @id @default(cuid())
  externalId     String
  date           DateTime
  source         String
  category       String
  headline       String
  summary        String?
  url            String
  imageUrl       String?
  relatedSymbols String[]
  publishedAt    DateTime
  createdAt      DateTime @default(now())

  @@unique([source, externalId])
  @@index([date])
  @@index([publishedAt])
}

model JobRun {
  id          String    @id @default(cuid())
  name        String
  status      JobStatus
  startedAt   DateTime
  finishedAt  DateTime
  durationMs  Int
  recordsRead Int       @default(0)
  recordsWritten Int    @default(0)
  error       String?
  details     Json
}

model AlphaScreenerRun {
  id               String   @id @default(cuid())
  date             DateTime @unique
  universeSize     Int
  targetCount      Int
  dailyFetchErrors Int      @default(0)
  buckets          Json
  createdAt        DateTime @default(now())
}

/// Screener LLM 情景目标价历史（用于日更锚定，避免大幅漂移）
model TargetPriceHistory {
  id           String   @id @default(cuid())
  symbol       String
  date         DateTime
  method       String
  currentPrice Float
  bearTarget   Float
  baseTarget   Float
  bullTarget   Float
  weightedFair Float
  scenarios    Json
  rationale    String
  source       String   @default("screener-llm")
  createdAt    DateTime @default(now())

  @@unique([symbol, date, source])
  @@index([symbol, date])
}
