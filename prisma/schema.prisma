generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum InstrumentType {
  STOCK
  ETF
  INDEX
}

enum WatchlistStatus {
  FOCUS
  NEW
  WATCH
  DOWNGRADED
}

enum JobStatus {
  SUCCESS
  FAILED
  PARTIAL
}

model Instrument {
  id        String         @id @default(cuid())
  symbol    String         @unique
  name      String
  type      InstrumentType
  sector    String?
  industry  String?
  exchange  String?
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  bars       DailyBar[]
  scores     StockScore[]
  states     WatchlistState[]
  sectorRows SectorScore[]    @relation("SectorInstrument")
}

model DailyBar {
  id           String   @id @default(cuid())
  instrumentId String
  date         DateTime
  open         Float
  high         Float
  low          Float
  close        Float
  volume       BigInt
  source       String
  createdAt    DateTime @default(now())

  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([instrumentId, date])
  @@index([date])
}

model MarketMetric {
  id           String   @id @default(cuid())
  date         DateTime
  mss          Float
  skewScore    Float?
  pcrScore     Float?
  creditScore  Float?
  breadthScore Float?
  confidence   Float
  details      Json
  createdAt    DateTime @default(now())

  @@unique([date])
}

/// MPR 宏观相变雷达的每日快照。
/// 只存展示与事件检测需要的字段；sigma 分级可由 dom* 推出，transDepth 可由 pathId 推出，故不落库。
model MacroPhaseState {
  id              String   @id @default(cuid())
  date            DateTime @unique
  pathId          Int
  fsmState        Int
  marketRiskScore Float
  prob5dDown      Float
  f1              Float
  f2              Float
  f3              Float
  f4              Float
  f5              Float
  rawTerm         Float
  rawCred         Float
  domVol          Float
  domCred         Float
  domSpot         Float
  spyDamage       Float
  leadGap         Float
  leadPersist     Int
  leadQuality     Float
  transVel        Float
  /// 传导深度 0~3 与耦合率，路径判定的中间量；默认值仅用于此前落库的历史行
  transDepth      Int      @default(0)
  couplingRatio   Float    @default(0)
  /// 三域各自的 σ 分级：0 平静 / 1 异动 / 2 极端
  sigmaVol        Int      @default(0)
  sigmaCred       Int      @default(0)
  sigmaSpot       Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([date])
}

model RotationState {
  id              String   @id @default(cuid())
  date            DateTime
  symbol          String
  close           Float
  rs              Float
  /// 0 空仓 / 1 一买 / 2 二买
  sigType         Int
  buy1            Boolean
  buy2            Boolean
  entryPrice      Float?
  stopLevel       Float?
  trailLevel      Float?
  effectiveStop   Float?
  floatPnlPct     Float
  maxPnlPct       Float
  breakevenLocked Boolean
  createdAt       DateTime @default(now())

  @@unique([date, symbol])
  @@index([date])
  @@index([symbol, date])
}

/// 个股深度面板的每日快照，一只标的一天一行。
model StockPanelState {
  id     String   @id @default(cuid())
  date   DateTime
  symbol String
  close  Float

  /// 对标 SPY 的相对强度，1~99
  rs             Float
  rsAccelerating Boolean
  /// MPR 口径的 4Q-Alpha 评分，1~99。与 rs 是两套算法，不可互比
  mprAlphaRs     Float   @default(50)
  /// Pine 的 stock_in_downtrend：close < EMA20 且 EMA20 < EMA50
  inShortDowntrend Boolean @default(false)
  /// T-CUBE 趋势打分，0~10
  trendScore     Int

  /// A/B/C/D/E/W
  stage           String
  /// T1/T2/T3
  baseTier        String
  baseDays        Int
  distFrom52wHigh Float
  squeezeRatio    Float

  /// 作用于日收益率的 Hurst，面板采用口径
  hurstReturn       Float
  /// trending / reverting / random
  hurstReturnRegime String
  /// Pine 原口径（作用于收盘价），仅作对照
  hurstPrice        Float

  /// vcp_nr7 / nr7 / vcp / inside_bar / normal
  volatilityPattern String
  volumeRatio       Float
  /// pocket_pivot / dry_up / inflow / outflow
  moneyFlow         String

  /// frozen / overextended / avoid / range
  dipKind       String
  /// prime / dry_up / normal / bottom / choppy，仅 range 有值
  dipQuality    String?
  dipLow        Float?
  dipHigh       Float?
  /// 仅 Stage D 有值，标出上方压制的 VWAP90
  dipResistance Float?

  /// SLS 时钟档位（TECH/FIN/...），ETF 无行业归属时为 null
  sectorId     String?
  /// 该行业在 11 档里的名次，1 最强
  sectorRank   Int?
  /// leader / bottoming / neutral / outflow
  sectorStatus String?

  buy1Signal  Boolean
  buy2Signal  Boolean
  /// sma(RSI14, 14)，风控入场闸门读的就是它
  smoothedRsi Float?

  /// 一买槽与二买槽相互独立，可同时持有
  buy1Entry  Float?
  buy1Stop   Float?
  buy1Trail  Float?
  buy1Locked Boolean
  buy2Entry  Float?
  buy2Stop   Float?
  buy2Trail  Float?
  buy2Locked Boolean

  /// 仲裁引擎出口
  tacticalAction String
  tacticalTone   String
  tacticalLayer  String

  createdAt DateTime @default(now())

  @@unique([date, symbol])
  @@index([date])
  @@index([symbol, date])
}

/// FMP 季度基本面快照，供 12M 估值引擎使用。
///
/// 季报一年只变四次，而 FMP 免费额度按天计，因此按周刷新、每天从这里读。
/// `fetchedAt` 用于判断是否过期。
model StockFundamentals {
  id                String   @id @default(cuid())
  symbol            String   @unique
  epsTtm            Float?
  revTtm            Float?
  sharesOutstanding Float?
  marketCap         Float?
  epsQYoY           Float?
  analystTarget     Float?
  analystCount      Int      @default(0)
  fetchedAt         DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 空头持仓缓存，FINRA 双月度结算 + SEC 在外股本。
///
/// 单独建表而不塞进 StockFundamentals：两者刷新节奏不同（季报按周、
/// 空头持仓双月一期），分母也不是同一口径——这里的 sharesOutstanding
/// 取自 SEC 封面页实际股数，而非 FMP 的加权平均稀释股本。
model ShortInterest {
  id     String @id @default(cuid())
  symbol String

  /// FINRA 的结算日，非发布日；发布常滞后 2~3 周
  settlementDate    DateTime
  sharesShort       Float
  /// SEC 取不到时为 null（ETF 无 XBRL 申报），此时占比按 0 处理
  sharesOutstanding Float?
  fetchedAt         DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([symbol, settlementDate])
  @@index([symbol])
}

/// 标普 500 的时点成分资格区间，供调参回测使用。
///
/// 存区间而不是逐日快照：原始数据是 2719 个变更日各一份完整名单，
/// 展开成 (ticker, date) 有 130 万行，压成区间只有两千余行，
/// 而「某日是否为成分」这个唯一的查询需求两种形式都能回答。
///
/// 同一 ticker 可能多次进出指数，因此一个 ticker 会有多行。
model IndexMembership {
  id     String @id @default(cuid())
  index  String @default("SP500")
  ticker String

  startDate DateTime
  /// null 表示仍在指数内
  endDate   DateTime?

  /// 日线回填是否成功。退市标的在 Yahoo 取不到价格，回测时必须排除
  hasBars  Boolean @default(false)
  barCount Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([index, ticker, startDate])
  @@index([ticker])
  @@index([hasBars])
}

/// 调参回测的行情面板，每只标的一行，序列按二进制打包。
///
/// 为什么不复用 DailyBar：标普池 700 只 × 20 年约 280 万行，在 DailyBar 的
/// 逐行结构下约 900MB，且冷加载要上百秒——回测工具需要一次把全池读进内存。
/// 打包成 Float32 后单只 80KB、全池约 56MB，一次查询即可载入。
///
/// DailyBar 仍是线上面板的数据源，两张表刻意不共用：面板要按日期范围查单只，
/// 回测要一次读全池，访问模式相反。
model BacktestPanel {
  id     String @id @default(cuid())
  ticker String @unique

  firstDate DateTime
  lastDate  DateTime
  barCount  Int

  /// 自 1970-01-01 起的天数，Int32LE
  days  Bytes
  /// 以下四列均为 Float32LE，长度与 barCount 一致
  high  Bytes
  low   Bytes
  close Bytes
  /// 成交股数。null 表示该行是加此列之前回填的，尚未补齐
  volume Bytes?
  /// 开盘价，仅顶背离用到。null 表示该行是加此列之前回填的，此时实体上沿退化为收盘价
  open Bytes?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 盘中回测面板。BacktestPanel.days 是日序号，同一天多根会塌掉，不能复用。
/// times 存自 1970-01-01 起的分钟数（Int32LE），解包为 `YYYY-MM-DDTHH:mm`。
model BacktestTfPanel {
  id        String @id @default(cuid())
  ticker    String
  timeframe String

  firstDate DateTime
  lastDate  DateTime
  barCount  Int

  times  Bytes
  high   Bytes
  low    Bytes
  close  Bytes
  volume Bytes
  open   Bytes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ticker, timeframe])
  @@index([timeframe])
}

/// 外生 RPS 标尺。约 1MB，构建和运行时读它，不必拉 72MB 标普面板。
model RpsScale {
  id          String   @id @default("spx")
  generatedAt DateTime
  index       String
  buckets     Int
  payload     Json
  updatedAt   DateTime @updatedAt
}

/// 12M 估值引擎的每日快照。
///
/// 与面板其余字段不同，这张表只有最新一天：基本面是当期值，
/// 复原历史某日的 EPS TTM 需要按公告日对齐全部季报并处理财报重述，
/// 而 `upsidePct` 只服务当日的低吸仲裁，没有历史序列的用途。
model StockValuation {
  id                String   @id @default(cuid())
  date              DateTime
  symbol            String
  close             Float
  primaryTarget     Float
  upsidePct         Float
  mode              String
  consensusSmoothed Boolean
  archetype         String
  currentPe         Float?
  calculatedPe      Float?
  marketCapB        Float?
  isDipActive       Boolean
  /// Pine 第 635 行的轧空短线目标价 close + 2×ATR×倍数
  shortTermTarget   Float    @default(0)
  /// extreme / warning / swing。缺 short interest 数据源，实际恒为 swing
  squeezeTier       String   @default("swing")
  /// 门槛判定的中间量，便于面板解释目标价为何是这个数
  isInLongDowntrend Boolean
  isHyperMomentum   Boolean
  tfAlpha           Float?

  createdAt DateTime @default(now())

  @@unique([date, symbol])
  @@index([date])
}

/// SLS 3.0 行业时钟的每日快照，一个行业一天一行。
model SectorClockState {
  id          String   @id @default(cuid())
  date        DateTime
  /// TECH / FIN / HEALTH / ...
  sectorId    String
  symbol      String
  /// 63 日绝对涨幅比率
  sls         Float
  /// 相对基准的 21 日比率差
  mom21       Float
  rank        Int
  isTop3      Boolean
  isBottoming Boolean

  createdAt DateTime @default(now())

  @@unique([date, sectorId])
  @@index([date])
}

model RotationTrade {
  id         String   @id @default(cuid())
  symbol     String
  sigType    Int
  entryDate  DateTime
  entryPrice Float
  exitDate   DateTime
  exitPrice  Float
  pnlPct     Float
  barsHeld   Int
  createdAt  DateTime @default(now())

  @@unique([symbol, entryDate])
  @@index([exitDate])
}

model SectorScore {
  id           String   @id @default(cuid())
  date         DateTime
  instrumentId String
  symbol       String
  name         String
  rs21         Float
  rs63         Float
  score        Float
  rank         Int
  createdAt    DateTime @default(now())

  instrument Instrument @relation("SectorInstrument", fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([date, symbol])
  @@index([date, rank])
}

model StockScore {
  id                String          @id @default(cuid())
  date              DateTime
  instrumentId      String
  symbol            String
  finalCompassScore Float
  qualityScore      Float
  momentumScore     Float
  trendScore        Float
  fundamentalScore  Float
  valuationScore    Float
  environmentScore  Float
  executionScore    Float
  killSwitchStatus  String
  killSwitchReason  String?
  rank              Int
  status            WatchlistStatus
  details           Json
  createdAt         DateTime        @default(now())

  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([date, symbol])
  @@index([date, rank])
}

model WatchlistState {
  id           String           @id @default(cuid())
  date         DateTime
  instrumentId String
  symbol       String
  previous     WatchlistStatus?
  current      WatchlistStatus
  reason       String
  createdAt    DateTime         @default(now())

  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([date, symbol])
  @@index([date, current])
}

model Report {
  id        String   @id @default(cuid())
  date      DateTime @unique
  title     String
  summary   String
  body      String
  version   String
  createdAt DateTime @default(now())
}

model NewsItem {
  id             String   @id @default(cuid())
  externalId     String
  date           DateTime
  source         String
  category       String
  headline       String
  summary        String?
  url            String
  imageUrl       String?
  relatedSymbols String[]
  publishedAt    DateTime
  createdAt      DateTime @default(now())

  @@unique([source, externalId])
  @@index([date])
  @@index([publishedAt])
}

model JobRun {
  id             String    @id @default(cuid())
  name           String
  status         JobStatus
  startedAt      DateTime
  finishedAt     DateTime
  durationMs     Int
  recordsRead    Int       @default(0)
  recordsWritten Int       @default(0)
  error          String?
  details        Json
}

model AlphaScreenerRun {
  id               String   @id @default(cuid())
  date             DateTime @unique
  universeSize     Int
  targetCount      Int
  dailyFetchErrors Int      @default(0)
  buckets          Json
  createdAt        DateTime @default(now())
}

/// Screener LLM 情景目标价历史（用于日更锚定，避免大幅漂移）
model TargetPriceHistory {
  id           String   @id @default(cuid())
  symbol       String
  date         DateTime
  method       String
  currentPrice Float
  bearTarget   Float
  baseTarget   Float
  bullTarget   Float
  weightedFair Float
  scenarios    Json
  rationale    String
  source       String   @default("screener-llm")
  createdAt    DateTime @default(now())

  @@unique([symbol, date, source])
  @@index([symbol, date])
}
