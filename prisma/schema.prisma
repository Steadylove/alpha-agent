generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum InstrumentType {
  STOCK
  ETF
  INDEX
}

enum WatchlistStatus {
  FOCUS
  NEW
  WATCH
  DOWNGRADED
}

enum JobStatus {
  SUCCESS
  FAILED
  PARTIAL
}

model Instrument {
  id        String         @id @default(cuid())
  symbol    String         @unique
  name      String
  type      InstrumentType
  sector    String?
  industry  String?
  exchange  String?
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  bars       DailyBar[]
  scores     StockScore[]
  states     WatchlistState[]
  sectorRows SectorScore[]    @relation("SectorInstrument")
}

model DailyBar {
  id           String   @id @default(cuid())
  instrumentId String
  date         DateTime
  open         Float
  high         Float
  low          Float
  close        Float
  volume       BigInt
  source       String
  createdAt    DateTime @default(now())

  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([instrumentId, date])
  @@index([date])
}

model MarketMetric {
  id           String   @id @default(cuid())
  date         DateTime
  mss          Float
  skewScore    Float?
  pcrScore     Float?
  creditScore  Float?
  breadthScore Float?
  confidence   Float
  details      Json
  createdAt    DateTime @default(now())

  @@unique([date])
}

/// MPR 宏观相变雷达的每日快照。
/// 只存展示与事件检测需要的字段；sigma 分级可由 dom* 推出，transDepth 可由 pathId 推出，故不落库。
model MacroPhaseState {
  id              String   @id @default(cuid())
  date            DateTime @unique
  pathId          Int
  fsmState        Int
  marketRiskScore Float
  prob5dDown      Float
  f1              Float
  f2              Float
  f3              Float
  f4              Float
  f5              Float
  rawTerm         Float
  rawCred         Float
  domVol          Float
  domCred         Float
  domSpot         Float
  spyDamage       Float
  leadGap         Float
  leadPersist     Int
  leadQuality     Float
  transVel        Float
  createdAt       DateTime @default(now())

  @@index([date])
}

model RotationState {
  id              String   @id @default(cuid())
  date            DateTime
  symbol          String
  close           Float
  rs              Float
  /// 0 空仓 / 1 一买 / 2 二买
  sigType         Int
  buy1            Boolean
  buy2            Boolean
  entryPrice      Float?
  stopLevel       Float?
  trailLevel      Float?
  effectiveStop   Float?
  floatPnlPct     Float
  maxPnlPct       Float
  breakevenLocked Boolean
  createdAt       DateTime @default(now())

  @@unique([date, symbol])
  @@index([date])
  @@index([symbol, date])
}

/// 个股深度面板的每日快照，一只标的一天一行。
model StockPanelState {
  id     String   @id @default(cuid())
  date   DateTime
  symbol String
  close  Float

  /// 对标 SPY 的相对强度，1~99
  rs             Float
  rsAccelerating Boolean
  /// T-CUBE 趋势打分，0~10
  trendScore     Int

  /// A/B/C/D/E/W
  stage           String
  /// T1/T2/T3
  baseTier        String
  baseDays        Int
  distFrom52wHigh Float
  squeezeRatio    Float

  /// 作用于日收益率的 Hurst，面板采用口径
  hurstReturn       Float
  /// trending / reverting / random
  hurstReturnRegime String
  /// Pine 原口径（作用于收盘价），仅作对照
  hurstPrice        Float

  /// vcp_nr7 / nr7 / vcp / inside_bar / normal
  volatilityPattern String
  volumeRatio       Float
  /// pocket_pivot / dry_up / inflow / outflow
  moneyFlow         String

  /// frozen / overextended / avoid / range
  dipKind       String
  /// prime / dry_up / normal / bottom / choppy，仅 range 有值
  dipQuality    String?
  dipLow        Float?
  dipHigh       Float?
  /// 仅 Stage D 有值，标出上方压制的 VWAP90
  dipResistance Float?

  /// SLS 时钟档位（TECH/FIN/...），ETF 无行业归属时为 null
  sectorId     String?
  /// 该行业在 11 档里的名次，1 最强
  sectorRank   Int?
  /// leader / bottoming / neutral / outflow
  sectorStatus String?

  buy1Signal  Boolean
  buy2Signal  Boolean
  /// sma(RSI14, 14)，风控入场闸门读的就是它
  smoothedRsi Float?

  /// 一买槽与二买槽相互独立，可同时持有
  buy1Entry  Float?
  buy1Stop   Float?
  buy1Trail  Float?
  buy1Locked Boolean
  buy2Entry  Float?
  buy2Stop   Float?
  buy2Trail  Float?
  buy2Locked Boolean

  /// 仲裁引擎出口
  tacticalAction String
  tacticalTone   String
  tacticalLayer  String

  createdAt DateTime @default(now())

  @@unique([date, symbol])
  @@index([date])
  @@index([symbol, date])
}

/// FMP 季度基本面快照，供 12M 估值引擎使用。
///
/// 季报一年只变四次，而 FMP 免费额度按天计，因此按周刷新、每天从这里读。
/// `fetchedAt` 用于判断是否过期。
model StockFundamentals {
  id                String   @id @default(cuid())
  symbol            String   @unique
  epsTtm            Float?
  revTtm            Float?
  sharesOutstanding Float?
  marketCap         Float?
  epsQYoY           Float?
  analystTarget     Float?
  analystCount      Int      @default(0)
  fetchedAt         DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 12M 估值引擎的每日快照。
///
/// 与面板其余字段不同，这张表只有最新一天：基本面是当期值，
/// 复原历史某日的 EPS TTM 需要按公告日对齐全部季报并处理财报重述，
/// 而 `upsidePct` 只服务当日的低吸仲裁，没有历史序列的用途。
model StockValuation {
  id                String   @id @default(cuid())
  date              DateTime
  symbol            String
  close             Float
  primaryTarget     Float
  upsidePct         Float
  mode              String
  consensusSmoothed Boolean
  archetype         String
  currentPe         Float?
  calculatedPe      Float?
  marketCapB        Float?
  isDipActive       Boolean
  /// 门槛判定的中间量，便于面板解释目标价为何是这个数
  isInLongDowntrend Boolean
  isHyperMomentum   Boolean
  tfAlpha           Float?

  createdAt DateTime @default(now())

  @@unique([date, symbol])
  @@index([date])
}

/// SLS 3.0 行业时钟的每日快照，一个行业一天一行。
model SectorClockState {
  id          String   @id @default(cuid())
  date        DateTime
  /// TECH / FIN / HEALTH / ...
  sectorId    String
  symbol      String
  /// 63 日绝对涨幅比率
  sls         Float
  /// 相对基准的 21 日比率差
  mom21       Float
  rank        Int
  isTop3      Boolean
  isBottoming Boolean

  createdAt DateTime @default(now())

  @@unique([date, sectorId])
  @@index([date])
}

model RotationTrade {
  id         String   @id @default(cuid())
  symbol     String
  sigType    Int
  entryDate  DateTime
  entryPrice Float
  exitDate   DateTime
  exitPrice  Float
  pnlPct     Float
  barsHeld   Int
  createdAt  DateTime @default(now())

  @@unique([symbol, entryDate])
  @@index([exitDate])
}

model SectorScore {
  id           String   @id @default(cuid())
  date         DateTime
  instrumentId String
  symbol       String
  name         String
  rs21         Float
  rs63         Float
  score        Float
  rank         Int
  createdAt    DateTime @default(now())

  instrument Instrument @relation("SectorInstrument", fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([date, symbol])
  @@index([date, rank])
}

model StockScore {
  id                String          @id @default(cuid())
  date              DateTime
  instrumentId      String
  symbol            String
  finalCompassScore Float
  qualityScore      Float
  momentumScore     Float
  trendScore        Float
  fundamentalScore  Float
  valuationScore    Float
  environmentScore  Float
  executionScore    Float
  killSwitchStatus  String
  killSwitchReason  String?
  rank              Int
  status            WatchlistStatus
  details           Json
  createdAt         DateTime        @default(now())

  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([date, symbol])
  @@index([date, rank])
}

model WatchlistState {
  id           String           @id @default(cuid())
  date         DateTime
  instrumentId String
  symbol       String
  previous     WatchlistStatus?
  current      WatchlistStatus
  reason       String
  createdAt    DateTime         @default(now())

  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([date, symbol])
  @@index([date, current])
}

model Report {
  id        String   @id @default(cuid())
  date      DateTime @unique
  title     String
  summary   String
  body      String
  version   String
  createdAt DateTime @default(now())
}

model NewsItem {
  id             String   @id @default(cuid())
  externalId     String
  date           DateTime
  source         String
  category       String
  headline       String
  summary        String?
  url            String
  imageUrl       String?
  relatedSymbols String[]
  publishedAt    DateTime
  createdAt      DateTime @default(now())

  @@unique([source, externalId])
  @@index([date])
  @@index([publishedAt])
}

model JobRun {
  id             String    @id @default(cuid())
  name           String
  status         JobStatus
  startedAt      DateTime
  finishedAt     DateTime
  durationMs     Int
  recordsRead    Int       @default(0)
  recordsWritten Int       @default(0)
  error          String?
  details        Json
}

model AlphaScreenerRun {
  id               String   @id @default(cuid())
  date             DateTime @unique
  universeSize     Int
  targetCount      Int
  dailyFetchErrors Int      @default(0)
  buckets          Json
  createdAt        DateTime @default(now())
}

/// Screener LLM 情景目标价历史（用于日更锚定，避免大幅漂移）
model TargetPriceHistory {
  id           String   @id @default(cuid())
  symbol       String
  date         DateTime
  method       String
  currentPrice Float
  bearTarget   Float
  baseTarget   Float
  bullTarget   Float
  weightedFair Float
  scenarios    Json
  rationale    String
  source       String   @default("screener-llm")
  createdAt    DateTime @default(now())

  @@unique([symbol, date, source])
  @@index([symbol, date])
}
