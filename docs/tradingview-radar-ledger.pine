f_clean(string raw) =>
    parts = str.split(raw, ":")
    array.size(parts) > 1 ? array.get(parts, array.size(parts) - 1) : raw

get_pos(string p) =>
    p == "Top Right" ? position.top_right : p == "Top Left" ? position.top_left : p == "Bottom Right" ? position.bottom_right : position.bottom_left

find_held(string id, string[] ids) =>
    int idx = -1
    if array.size(ids) > 0
        for i = 0 to array.size(ids) - 1
            if array.get(ids, i) == id
                idx := i
                break
    idx

