f_held_value() =>
    float v = 0.0
    if array.size(held_id) > 0
        for i = 0 to array.size(held_id) - 1
            string id = array.get(held_id, i)
            for k = 0 to 39
                if array.get(syms, k) == id and not na(array.get(cxs, k))
                    v += array.get(held_sh, i) * array.get(cxs, k)
                    break
    v

// 先平后买。平仓必须写在主流程里：Pine 函数不能改 cash / ytd_* 全局变量
if array.size(held_id) > 0
    for i = array.size(held_id) - 1 to 0
        string id = array.get(held_id, i)
        int k = -1
        for j = 0 to 39
            if array.get(syms, j) == id
                k := j
                break
        if k >= 0
            bool dead = array.get(jout, k) or array.get(sigs, k) == 0
            float px = array.get(cxs, k)
            if dead and not na(px) and px > 0
                float proceeds = array.get(held_sh, i) * px * (1.0 - cost)
                float basis = array.get(held_cost, i)
                cash := cash + proceeds
                if year >= stat_year
                    ytd_trades := ytd_trades + 1
                    if proceeds > basis
                        ytd_wins := ytd_wins + 1
                array.remove(held_id, i)
                array.remove(held_sh, i)
                array.remove(held_cost, i)
                array.remove(held_ent, i)
                array.remove(held_sig, i)

equity := cash + f_held_value()

int[] cand = array.new_int()
float[] cand_rs = array.new_float()
for k = 0 to 39
    if array.get(jin, k) and not array.get(jout, k) and array.get(cxs, k) > 0
        if find_held(array.get(syms, k), held_id) < 0
            array.push(cand, k)
            array.push(cand_rs, nz(array.get(rss, k), 1.0))

if array.size(cand) > 1
    for a = 0 to array.size(cand) - 2
        for b = a + 1 to array.size(cand) - 1
            if array.get(cand_rs, b) > array.get(cand_rs, a)
                int ti = array.get(cand, a)
                float tr = array.get(cand_rs, a)
                array.set(cand, a, array.get(cand, b))
                array.set(cand_rs, a, array.get(cand_rs, b))
                array.set(cand, b, ti)
                array.set(cand_rs, b, tr)

if array.size(cand) > 0
    for n = 0 to array.size(cand) - 1
        if array.size(held_id) >= max_slots
            break
        float want = equity * slot_pct
        if cash < want or want <= 0
            break
        int k = array.get(cand, n)
        float px = array.get(cxs, k)
        cash := cash - want
        array.push(held_id, array.get(syms, k))
        array.push(held_sh, want * (1.0 - cost) / px)
        array.push(held_cost, want)
        array.push(held_ent, px)
        array.push(held_sig, array.get(sigs, k))
        equity := cash + f_held_value()

equity := cash + f_held_value()

if na(ytd_start)
    ytd_start := year(time) >= stat_year ? equity : na
if not na(year[1]) and year != year[1] and year >= stat_year
    ytd_start := equity[1]
    ytd_trades := 0
    ytd_wins := 0

float open_unreal = 0.0
if array.size(held_id) > 0
    for i = 0 to array.size(held_id) - 1
        string id = array.get(held_id, i)
        for k = 0 to 39
            if array.get(syms, k) == id and not na(array.get(cxs, k))
                open_unreal += array.get(held_sh, i) * array.get(cxs, k) - array.get(held_cost, i)
                break

float ytd_pct = not na(ytd_start) and ytd_start > 0 ? (equity / ytd_start - 1.0) * 100.0 : 0.0
float float_pct = equity > 0 ? open_unreal / equity * 100.0 : 0.0
float expos_pct = equity > 0 ? (equity - cash) / equity * 100.0 : 0.0
float cash_pct = 100.0 - expos_pct
int n_hold = array.size(held_id)
float win_rate = ytd_trades > 0 ? float(ytd_wins) / float(ytd_trades) * 100.0 : 0.0
bool tf_ok = timeframe.period == radar_tf or (timeframe.period == "D" and radar_tf == "1D")

color c_tbl_bg    = color.new(#131722, 10)
color c_tbl_frame = color.new(#2a2e39, 0)
color c_head_bg   = color.new(#1e222d, 0)
color c_head_text = #94a3b8
color c_row_even  = color.new(#171b26, 20)
color c_row_odd   = color.new(#131722, 20)
color c_val_text  = #f1f5f9
color c_pos_green = #089981
color c_neg_red   = #f23645
color c_sl_warn   = #fbbf24

var table radarTable = na
if show_radar and barstate.islast
    if not na(radarTable)
        table.delete(radarTable)
    int rows = (only_active ? math.max(n_hold, 0) : 40) + 3
    radarTable := table.new(get_pos(table_pos), 7, math.max(4, rows), bgcolor=c_tbl_bg, frame_color=c_tbl_frame, frame_width=1, border_width=1, border_color=color.new(#2a2e39, 40))
    string warn = tf_ok ? "" : "  |  图表周期必须改成 " + radar_tf
    string kpi1 = "现金账本  持仓 " + str.tostring(n_hold) + "/" + str.tostring(max_slots) + "  敞口 " + str.tostring(expos_pct, "#.#") + "%  现金 " + str.tostring(cash_pct, "#.#") + "%" + warn
    string kpi2 = "净值YTD " + (ytd_pct >= 0 ? "+" : "") + str.tostring(ytd_pct, "#.##") + "%  浮动占净值 " + (float_pct >= 0 ? "+" : "") + str.tostring(float_pct, "#.##") + "%  今年平仓 " + str.tostring(ytd_trades) + "战" + str.tostring(ytd_wins) + "胜 (" + str.tostring(win_rate, "#0") + "%)"
    table.cell(radarTable, 0, 0, kpi1, text_color=tf_ok ? #fbbf24 : #f23645, text_size=size.small, bgcolor=c_head_bg)
    table.merge_cells(radarTable, 0, 0, 6, 0)
    table.cell(radarTable, 0, 1, kpi2, text_color=#38bdf8, text_size=size.small, bgcolor=c_head_bg)
    table.merge_cells(radarTable, 0, 1, 6, 1)
    table.cell(radarTable, 0, 2, "代码", text_color=c_head_text, text_size=size.small, bgcolor=c_head_bg)
    table.cell(radarTable, 1, 2, "账本仓位", text_color=c_head_text, text_size=size.small, bgcolor=c_head_bg)
    table.cell(radarTable, 2, 2, "开仓成本", text_color=c_head_text, text_size=size.small, bgcolor=c_head_bg)
    table.cell(radarTable, 3, 2, "个股浮盈", text_color=c_head_text, text_size=size.small, bgcolor=c_head_bg)
    table.cell(radarTable, 4, 2, "净值拉动", text_color=c_head_text, text_size=size.small, bgcolor=c_head_bg)
    table.cell(radarTable, 5, 2, "RS", text_color=c_head_text, text_size=size.small, bgcolor=c_head_bg)
    table.cell(radarTable, 6, 2, "止损", text_color=c_head_text, text_size=size.small, bgcolor=c_head_bg)

    int row_idx = 3
    for i = 0 to 39
        string id = array.get(syms, i)
        int h = find_held(id, held_id)
        bool show = only_active ? h >= 0 : true
        if show
            color row_bg = row_idx % 2 == 1 ? c_row_even : c_row_odd
            float px = array.get(cxs, i)
            float w = 0.0
            float contrib = 0.0
            float lot = 0.0
            float ent = h >= 0 ? array.get(held_ent, h) : array.get(ents, i)
            if h >= 0 and not na(px) and equity > 0
                float val = array.get(held_sh, h) * px
                w := val / equity * 100.0
                contrib := (val - array.get(held_cost, h)) / equity * 100.0
                lot := ent > 0 ? (px - ent) / ent * 100.0 : 0.0
            table.cell(radarTable, 0, row_idx, f_clean(id), text_color=c_val_text, text_size=size.small, bgcolor=row_bg)
            table.cell(radarTable, 1, row_idx, h >= 0 ? str.tostring(w, "#.#") + "%" : "--", text_color=#93c5fd, text_size=size.small, bgcolor=row_bg)
            table.cell(radarTable, 2, row_idx, h >= 0 and not na(ent) ? "$" + str.tostring(ent, "#.##") : "--", text_color=c_val_text, text_size=size.small, bgcolor=row_bg)
            table.cell(radarTable, 3, row_idx, h >= 0 ? ((lot >= 0 ? "+" : "") + str.tostring(lot, "#.##") + "%") : "--", text_color=lot >= 0 ? c_pos_green : c_neg_red, text_size=size.small, bgcolor=row_bg)
            table.cell(radarTable, 4, row_idx, h >= 0 ? ((contrib >= 0 ? "+" : "") + str.tostring(contrib, "#.##") + "%") : "--", text_color=contrib >= 0 ? c_pos_green : c_neg_red, text_size=size.small, bgcolor=row_bg)
            table.cell(radarTable, 5, row_idx, str.tostring(array.get(rss, i), "#0"), text_color=c_head_text, text_size=size.small, bgcolor=row_bg)
            table.cell(radarTable, 6, row_idx, h >= 0 and not na(array.get(sls, i)) ? "$" + str.tostring(array.get(sls, i), "#.##") : "--", text_color=c_sl_warn, text_size=size.small, bgcolor=row_bg)
            row_idx += 1
