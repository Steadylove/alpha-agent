// =============================================================================
// 美股动能雷达 · 现金账本
// =============================================================================
//
// 买卖、止损仍是原雷达（一买/二买，止 4 ATR，吊灯 5.5/4.2/3.5，赚 10% 抬到成本+1%）。
// 改的是仓位和 YTD：
//   · 每笔按当时净值的 12.5% 开
//   · 最多 8 只，现金不够一整槽就不开
//   · 不置换
//   · 买卖各扣 10bps
//   · YTD 是这份净值从统计年起涨了多少，不是 40 只收益率加总再除以 8
//
// 图表周期必须等于「监控计算周期」。4H 看板就把两者都设成 240。
// 对不齐的话，账本会漏掉盘中那根 4H。
// 对照本地时只用下面这 40 只，不要另加 IBM / NEE。
//
// =============================================================================

//@version=5
indicator("美股动能雷达·现金账本", overlay = true, max_bars_back = 2000)

group_dashboard = "看板"
show_radar      = input.bool(true, "显示看板", group=group_dashboard)
only_active     = input.bool(true, "只显示账本持仓", group=group_dashboard)
radar_tf        = input.timeframe("240", "监控计算周期", group=group_dashboard)
stat_year       = input.int(2026, "净值 YTD 起始年", group=group_dashboard)
table_pos       = input.string("Top Right", "位置", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=group_dashboard)

group_book      = "账本"
slot_pct        = input.float(12.5, "单票仓位 %", minval=1, maxval=50, step=0.5, group=group_book) / 100.0
max_slots       = input.int(8, "最多持股", minval=1, maxval=16, group=group_book)
cost_bps        = input.float(10, "单边成本 bps", minval=0, maxval=50, step=1, group=group_book)
cost            = cost_bps / 10000.0

group_filters   = "开仓过滤"
use_rsi_filter  = input.bool(false, "RSI 过滤", group=group_filters)
rsi_threshold   = input.int(30, "RSI 门槛", minval=10, maxval=50, group=group_filters)

