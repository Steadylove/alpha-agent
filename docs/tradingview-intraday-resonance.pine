//@version=6
indicator("TREND ADAPTIVE · Intraday Resonance v1.0.0", overlay=true, max_lines_count=10, max_labels_count=20)

// Formula version: user's resonance revision, 2026-09-28. MACD is NOT an entry gate.
// Standard 1-minute candles + Extended session. Signal prices are NOT broker fills.
string VERSION = "1.0.0"
string TZ = "America/New_York"
window = input.session("0400-0930", "入场时段（美东）", group="交易时段")
useScanner = input.bool(true, "启用低价/涨幅/成交量/流通盘过滤", group="股票过滤")
minPrice = input.float(1, "最低价", minval=0.01, group="股票过滤")
maxPrice = input.float(20, "最高价", minval=0.01, group="股票过滤")
minGain = input.float(20, "相对昨收涨幅下限 %", minval=0, group="股票过滤")
minRvol = input.float(5, "当日累计量 / 前50日均量下限", minval=0, group="股票过滤")
maxFloat = input.float(20000000, "流通股数上限（严格小于）", minval=1, group="股票过滤")
stopLookback = input.int(8, "入场锁定低点回看根数", minval=2, maxval=30, group="信号管理")
closeAtEnd = input.bool(true, "时段结束产生模型出场", group="信号管理")
showFib = input.bool(true, "显示最新120根静态斐波那契参考", group="显示")
showRaw = input.bool(false, "显示未通过股票过滤的原始买点", group="显示")
if barstate.isfirst and (not timeframe.isminutes or timeframe.multiplier != 1 or not chart.is_standard)
    runtime.error("请使用标准1分钟K线，并将图表及列表告警设为 Extended。")
if barstate.isfirst and minPrice > maxPrice
    runtime.error("最低价不能高于最高价。")

// 1. Unique trigger. Explicit ta.rma seed convention; no claim of cross-vendor seed parity.
var1f = (close - ta.lowest(low, 27)) / math.max(ta.highest(high, 27) - ta.lowest(low, 27), 0.0001) * 100
var21 = ta.rma(var1f, 3)
trend = ta.rma(var21, 3)
powerline = ta.rma(trend, 3)
ind1Buy = ta.crossover(trend, powerline) and trend < 30.0

// 2. Original strict Williams-position conditions.
wr34 = -100 * (ta.highest(high, 34) - close) / math.max(ta.highest(high, 34) - ta.lowest(low, 34), 0.0001)
wr14 = -100 * (ta.highest(high, 14) - close) / math.max(ta.highest(high, 14) - ta.lowest(low, 14), 0.0001)
longLine = ta.sma(wr34, 19) + 100
fundLine = wr14 + 100
mainLine = ta.ema(wr34, 4) + 100
caopan = (longLine < 12 and mainLine < 8 and (fundLine < 7.2 or fundLine[1] < 5) and (mainLine > mainLine[1] or fundLine > fundLine[1])) or (longLine < 8 and mainLine < 7 and fundLine < 15 and fundLine > fundLine[1]) or (longLine < 10 and mainLine < 7 and fundLine < 1)
fundCrossLong = ta.crossover(fundLine, longLine)
changduan = longLine < 15 and longLine[1] < 15 and mainLine < 18 and fundLine > fundLine[1] and fundCrossLong and fundLine > mainLine and (fundLine[1] < 5 or fundLine[2] < 5) and (mainLine >= longLine or fundLine[1] < 1)
oversoldBar = caopan or changduan
pivotBuy = fundCrossLong and fundLine > mainLine and longLine < 35.0
sinceOversold = ta.barssince(oversoldBar)
sincePivot = ta.barssince(pivotBuy)
premium = ind1Buy and not na(sinceOversold) and sinceOversold <= 2
pivot = ind1Buy and not na(sincePivot) and sincePivot <= 2
rawBuy = premium or pivot

// 3. FILTER(X,N): after an emitted event suppress the following N bars.
// Rejected bars do NOT restart the cooldown. Update on confirmed bars only.
var int lastBuy = na
cleanBuy = rawBuy and (na(lastBuy) or bar_index - lastBuy > 4)
if barstate.isconfirmed and cleanBuy
    lastBuy := bar_index

// 4. User's exact top / reduce conditions; no old RSI/MACD sell gate mixed in.
topZone = mainLine < mainLine[1] and mainLine[1] > 80.0 and (fundLine[1] > 95.0 or fundLine[2] > 95.0) and longLine > 60.0 and fundLine < 83.5 and fundLine < mainLine and fundLine < longLine + 4.0
var int lastTop = na
topSignal = topZone and (na(lastTop) or bar_index - lastTop > 5)
if barstate.isconfirmed and topSignal
    lastTop := bar_index
range9 = math.max(ta.highest(high, 9) - ta.lowest(low, 9), 0.0001)
var1b = (ta.highest(high, 9) - close) / range9 * 100 - 70
var2b = ta.rma(var1b, 9) + 100
var3b = (close - ta.lowest(low, 9)) / range9 * 100
var4b = ta.rma(var3b, 3)
var5b = ta.rma(var4b, 3) + 100
var6b = var5b - var2b
trend1 = math.max(var6b - 45, 0)
powerCross = ta.crossover(powerline, trend)
condSell = (powerCross and trend1 > 50.0) or (trend1 > 70.0 and trend1 < trend1[1])
var int lastSell = na
finalSell = condSell and (na(lastSell) or bar_index - lastSell > 4)
if barstate.isconfirmed and finalSell
    lastSell := bar_index

// Daily reference is completed RTH data only. [1] + lookahead_on never uses today's final daily values.
regularTicker = ticker.new(syminfo.prefix, syminfo.ticker, session.regular)
[priorClose, avgVolume50] = request.security(regularTicker, "D", [close[1], ta.sma(volume, 50)[1]], lookahead=barmerge.lookahead_on)
dayKey = year(time, TZ) * 10000 + month(time, TZ) * 100 + dayofmonth(time, TZ)
newDay = na(dayKey[1]) or dayKey != dayKey[1]
var float dayVolume = 0.0
dayVolume := newDay ? nz(volume) : dayVolume + nz(volume)
gainPct = not na(priorClose) and priorClose > 0 ? (close / priorClose - 1) * 100 : na
rvol = not na(avgVolume50) and avgVolume50 > 0 ? dayVolume / avgVolume50 : na
floatShares = syminfo.shares_outstanding_float
scannerPass = close >= minPrice and close <= maxPrice and not na(gainPct) and gainPct >= minGain and not na(rvol) and rvol >= minRvol and not na(floatShares) and floatShares < maxFloat and not na(volume)
eligible = not useScanner or scannerPass
inSession = not na(time(timeframe.period, window + ":23456", TZ))
lastSessionBar = inSession and na(time(timeframe.period, window + ":23456", TZ, bars_back=-1))
stopCandidate = ta.lowest(low, stopLookback)

// Parameters are part of the identity. Changing any input requires recreating the TV alert.
f_n(float x) => na(x) ? "null" : str.tostring(x, "#.########")
f_b(bool x) => x ? "true" : "false"
parameters = '{"scanner":' + f_b(useScanner) + ',"minPrice":' + f_n(minPrice) + ',"maxPrice":' + f_n(maxPrice) + ',"minGain":' + f_n(minGain) + ',"minRvol":' + f_n(minRvol) + ',"maxFloat":' + f_n(maxFloat) + ',"stopLookback":' + str.tostring(stopLookback) + ',"closeAtEnd":' + f_b(closeAtEnd) + ',"session":"' + window + '","buyCooldown":4,"sellCooldown":4,"topCooldown":5,"resonanceBars":3,"newsRequired":false}'
strategyKey = "resonance-" + VERSION + "|" + window + "|" + f_b(useScanner) + "|" + f_n(minPrice) + "|" + f_n(maxPrice) + "|" + f_n(minGain) + "|" + f_n(minRvol) + "|" + f_n(maxFloat) + "|" + str.tostring(stopLookback) + "|" + f_b(closeAtEnd)

// This state is a signal model, not an actual brokerage position. varip prevents repeated tick stops.
varip float entryPrice = na
varip float lockedStop = na
varip int entryAt = na
varip int entryBar = na
varip int entryDay = na
varip bool reduced = false
varip int closedBar = na
varip int processedClose = na
f_packet(string event, string reason, float refPrice, int signalAt, int entryTime, float entryRef, float stopRef) =>
    metrics = '{"gainPct":' + f_n(gainPct) + ',"rvol":' + f_n(rvol) + ',"dayVolume":' + f_n(dayVolume) + ',"floatShares":' + f_n(floatShares) + ',"trend":' + f_n(trend) + ',"powerline":' + f_n(powerline) + ',"longLine":' + f_n(longLine) + ',"fundLine":' + f_n(fundLine) + ',"mainLine":' + f_n(mainLine) + ',"trend1":' + f_n(trend1) + ',"premium":' + f_b(premium) + ',"pivot":' + f_b(pivot) + ',"top":' + f_b(topSignal) + ',"reduce":' + f_b(finalSell) + ',"newsVerified":false}'
    '{"protocol":"intraday-v1","strategy":"resonance-long","scriptVersion":"' + VERSION + '","strategyKey":"' + strategyKey + '","symbol":"' + syminfo.prefix + ':' + syminfo.ticker + '","tf":"1","event":"' + event + '","reason":"' + reason + '","barTime":' + str.tostring(time) + ',"signalTime":' + str.tostring(signalAt) + ',"entrySignalTime":' + (na(entryTime) ? "null" : str.tostring(entryTime)) + ',"price":' + f_n(refPrice) + ',"entryPrice":' + f_n(entryRef) + ',"stop":' + f_n(stopRef) + ',"metrics":' + metrics + ',"parameters":' + parameters + '}'

// Stop has priority. Historical bars use conservative gap handling, realtime uses observed tick price.
stopTouched = not na(entryPrice) and bar_index > entryBar and low <= lockedStop
if stopTouched
    stopPrice = barstate.isrealtime ? close : math.min(open, lockedStop)
    stopTime = barstate.isrealtime ? timenow : time_close
    alert(f_packet("stop", "stop_touch", stopPrice, stopTime, entryAt, entryPrice, lockedStop), alert.freq_all)
    entryPrice := na
    closedBar := bar_index

bool entryMark = false
bool watchMark = false
bool partialMark = false
bool exitMark = false
if barstate.isconfirmed and (na(processedClose) or processedClose != bar_index)
    processedClose := bar_index
    hasPosition = not na(entryPrice)
    gapExit = hasPosition and closeAtEnd and (dayKey != entryDay or not inSession)
    mustExit = hasPosition and (topSignal or (closeAtEnd and lastSessionBar) or gapExit)
    if mustExit
        reason = topSignal ? "resonance_top" : gapExit ? "session_gap" : "session_end"
        alert(f_packet("exit", reason, close, time_close, entryAt, entryPrice, lockedStop), alert.freq_all)
        entryPrice := na
        closedBar := bar_index
        exitMark := true
    else if hasPosition and finalSell and not reduced
        alert(f_packet("partial", "resonance_reduce", close, time_close, entryAt, entryPrice, lockedStop), alert.freq_all)
        reduced := true
        partialMark := true
    if cleanBuy and eligible and inSession and not (closeAtEnd and lastSessionBar) and (na(closedBar) or closedBar != bar_index)
        reason = premium ? "premium_resonance" : "pivot_resonance"
        if na(entryPrice) and stopCandidate > 0 and stopCandidate < close
            entryPrice := close
            lockedStop := stopCandidate
            entryAt := time_close
            entryBar := bar_index
            entryDay := dayKey
            reduced := false
            alert(f_packet("entry", reason, close, time_close, entryAt, entryPrice, lockedStop), alert.freq_all)
            entryMark := true
        else
            // A repeated buy setup while a model trade is open is retained, without a second entry.
            alert(f_packet("watch", reason, close, time_close, na, na, stopCandidate > 0 ? stopCandidate : na), alert.freq_all)
            watchMark := true

plotshape(entryMark and premium, "优质买点", shape.triangleup, location.belowbar, color.aqua, text="优质买点", textcolor=color.aqua, size=size.small)
plotshape(entryMark and pivot and not premium, "能量共振", shape.triangleup, location.belowbar, color.orange, text="能量共振", textcolor=color.orange, size=size.small)
plotshape(watchMark, "持有中再次共振", shape.circle, location.belowbar, color.gray, size=size.tiny)
plotshape(partialMark, "减仓", shape.triangledown, location.abovebar, color.lime, text="减仓", textcolor=color.lime)
plotshape(exitMark, "逃顶/时段出场", shape.triangledown, location.abovebar, color.yellow, text="出场", textcolor=color.yellow)
plotshape(showRaw and cleanBuy and barstate.isconfirmed and not entryMark and not watchMark, "原始共振（未开仓）", shape.circle, location.belowbar, color.gray, size=size.tiny)
plot(not na(entryPrice) ? lockedStop : na, "入场锁定止损", color.red, 2, plot.style_linebr)
plot(trend, "TREND", display=display.data_window)
plot(powerline, "POWERLINE", display=display.data_window)
plot(cleanBuy ? 1 : 0, "CLEAN_BUY", display=display.data_window)
plot(topSignal ? 1 : 0, "TOP_SIGNAL", display=display.data_window)
plot(finalSell ? 1 : 0, "FINAL_SELL", display=display.data_window)

// Latest-window visual ruler only. Never read these lines in entry/exit logic.
fibHigh = ta.highest(high, 120)
fibLow = ta.lowest(low, 120)
var lines = array.new_line()
var labels = array.new_label()
if barstate.islast
    for l in lines
        line.delete(l)
    for lab in labels
        label.delete(lab)
    array.clear(lines)
    array.clear(labels)
    if showFib
        levels = array.from(fibHigh, fibHigh - (fibHigh - fibLow) * 0.382, fibHigh - (fibHigh - fibLow) * 0.5, fibHigh - (fibHigh - fibLow) * 0.618, fibLow)
        colors = array.from(color.lime, color.white, color.yellow, color.fuchsia, color.red)
        texts = array.from("100.0 MAX", "38.2 FIB", "50.0 MID", "61.8 FIB", "0.0 BASE")
        for i = 0 to 4
            level = array.get(levels, i)
            hue = array.get(colors, i)
            array.push(lines, line.new(math.max(0, bar_index - 119), level, bar_index, level, color=hue, width=4))
            array.push(labels, label.new(bar_index, level, array.get(texts, i), style=label.style_label_left, color=color.new(color.black, 100), textcolor=hue))

var hud = table.new(position.top_right, 1, 4, bgcolor=color.new(color.black, 20))
if barstate.islast
    table.cell(hud, 0, 0, "TREND ADAPTIVE · 共振 " + VERSION, text_color=color.white)
    table.cell(hud, 0, 1, inSession ? "监控时段（ET）" : "入场时段外", text_color=inSession ? color.aqua : color.gray)
    table.cell(hud, 0, 2, useScanner ? (scannerPass ? "股票过滤通过" : "股票过滤未通过/数据缺失") : "股票过滤已关闭", text_color=eligible ? color.lime : color.orange)
    table.cell(hud, 0, 3, "新闻未核验 · 模型信号≠真实持仓", text_color=color.silver)
