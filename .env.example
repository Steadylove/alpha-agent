# 运行时不连 Postgres。行情和看板读 VPS 文件（:8787 CSV / desk）。
# 写库脚本仍看这条，但 getPrisma() 会拒连。
DATABASE_URL=""
# 行情根目录。VPS 上是 /var/lib/alpha-agent/market（1d/4h/2h/1h/rps）
MARKET_DATA_DIR=""
# VPS 日更：/var/lib/alpha-agent/daily-quant.env（ALPACA_*）。定时北京周二到周六 08:30。
DISCORD_WEBHOOK_URL=""
# 买卖点推送单开一个频道；留空则回落到上面那个
DISCORD_SIGNAL_WEBHOOK_URL=""
# 读 #option 的 Bot。门槛 0 表示先入库不按金额过滤；转发以后再用。
DISCORD_BOT_TOKEN=""
DISCORD_OPTION_CHANNEL_ID="1546768709735948378"
# 有 webhook 就走 webhook；没有则 Robby 发到这个频道（默认 Quill #常规）
DISCORD_SIGNAL_CHANNEL_ID="1530212207089160374"
OPTION_FLOW_MIN_PREMIUM_USD="0"
OPTION_FLOW_DROP_ADS="true"
OPTION_FLOW_DROP_PAID="true"
OPTION_FLOW_POLL_MS="3000"
# Telegram Token 在 VPS /var/lib/alpha-agent/telegram-config/telegram.config.mjs 中配置。
# Vercel 线上自动用项目服务身份认证；本地 CLI 可配置单独的 relaySecret。
TELEGRAM_RELAY_URL=""
TELEGRAM_RELAY_SECRET=""
CRON_SECRET="change-me"
# 回看快照写 VPS。线上 Vercel 未设时回落 CRON_SECRET；VPS 未设则不校验
DESK_STORE_SECRET=""
FMP_API_KEY=""
FRED_API_KEY=""
FINNHUB_API_KEY=""
DEEPSEEK_API_KEY=""
SCREENER_SKIP_AI="true"
ALPACA_API_KEY=""
ALPACA_API_SECRET=""
# Dashboard → API Keys 的 Key ID / Secret Key，不是 OAuth Client。
