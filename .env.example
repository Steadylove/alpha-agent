# Private web login; set a unique password of at least 6 characters.
DESK_PASSWORD=
# IB Gateway/TWS must already be logged in, with socket API enabled.
IB_HOST=127.0.0.1
IB_PORT=4002
IB_CLIENT_ID=71
# Explicit account selection is required if IBKR returns multiple accounts.
IB_ACCOUNT=
# real requests live data; delayed explicitly requests delayed data.
IB_DATA_MODE=real
# All accounts are permanently read-only; there is no trading enable switch.
DESK_DB=.data/desk.sqlite3
