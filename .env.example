# TREND ADAPTIVE · 本地开发基础配置
# 复制为 .env；本机覆盖写 .env.local。不要覆盖已有文件。
# Next / CLI 优先级：进程环境 > 模式 local 文件 > .env.local > 模式文件 > .env。
# NODE_ENV=test 时跳过 .env.local；CLI 可用 DOTENV_CONFIG_PATH 指定单一文件。
# 公开默认值：app.config.ts；检查与说明：scripts/env.ts、docs/environment.md。

# 1. 数据读取（二选一）：远程 URL 非空时优先读远程；否则用本地 CSV。
MARKET_DATA_BASE_URL=""
MARKET_DATA_DIR=""

# 2. 任务和文件服务鉴权：填写实际部署使用的同一密钥。
CRON_SECRET=""
DESK_STORE_SECRET=""

# 3. 自行采集行情时需要；仅浏览远程复盘可留空。
ALPACA_API_KEY=""
ALPACA_API_SECRET=""
# ALPACA_FEED=sip
# ALPACA_MAX_INFLIGHT=3

# 4. 推送默认值。具体频道、开关、金额门槛统一在网站 /push 保存。
DISCORD_WEBHOOK_URL=""
DISCORD_SIGNAL_WEBHOOK_URL=""
# DISCORD_MIRROR_GEX_WEBHOOK_URL=""
# DISCORD_MIRROR_BOOK_WEBHOOK_URL=""
# DISCORD_MIRROR_4H_WEBHOOK_URL=""
# DISCORD_MIRROR_2H_WEBHOOK_URL=""
TELEGRAM_RELAY_URL=""
TELEGRAM_RELAY_SECRET=""
# TELEGRAM_ENABLED=false

# 5. 可选数据与独立 AI 分析；未配置时保留对应来源不可用状态。
FMP_API_KEY=""
SEC_USER_AGENT=""
DEEPSEEK_API_KEY=""
DEEPSEEK_REVIEW_API_KEY=""
# DEEPSEEK_REVIEW_MODEL=deepseek-v4-pro
# DEEPSEEK_CATALYST_API_KEY=""
# DEEPSEEK_CONTEXT_API_KEY=""
SCREENER_SKIP_AI=true

# 6. 仅 Theta 本地期权研究使用；可放 .env.local。
# THETADATA_API_KEY=""

# VPS 日更：daily-quant.env；期权流：option-flow.env；详见 docs/environment.md。
# Vercel 生产密钥自动从 VPS web-secrets.json 读取，不在控制台填写。
# 不需要 DATABASE_URL、FRED_API_KEY 或 FINNHUB_API_KEY。
