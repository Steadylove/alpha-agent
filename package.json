{
  "name": "alpha-agent",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && npx --yes tsx scripts/fetch-panel-cache.ts && npx --yes tsx scripts/ensure-lab-csv.ts && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "screener:push": "npx --yes tsx scripts/push-daily-screener.ts",
    "jobs:daily": "npx --yes tsx scripts/run-daily-jobs.ts",
    "backfill:macro": "npx --yes tsx scripts/backfill-macro-history.ts",
    "backfill:rotation": "npx --yes tsx scripts/backfill-rotation-history.ts",
    "backfill:sectors": "npx --yes tsx scripts/backfill-sectors.ts",
    "membership:import": "npx --yes tsx scripts/import-index-membership.ts",
    "backfill:panel": "npx --yes tsx scripts/backfill-sp500-panel.ts",
    "panel:cache": "npx --yes tsx scripts/build-panel-cache.ts",
    "panel:fetch": "npx --yes tsx scripts/fetch-panel-cache.ts",
    "lab": "NODE_OPTIONS=--max-old-space-size=6144 npx --yes tsx scripts/backtest-lab.ts",
    "lab:search": "NODE_OPTIONS=--max-old-space-size=6144 npx --yes tsx scripts/search-params.ts",
    "calibrate:mpr": "npx --yes tsx scripts/calibrate-mpr.ts",
    "backtest:portfolio": "npx --yes tsx scripts/backtest-portfolio.ts",
    "backtest:rotation": "npx --yes tsx scripts/backtest-rotation.ts",
    "calibrate:rotation": "npx --yes tsx scripts/calibrate-rotation.ts",
    "calibrate:stock-panel": "npx --yes tsx scripts/calibrate-stock-panel.ts",
    "compare:mpr": "npx --yes tsx scripts/compare-mpr-tradingview.ts",
    "smallfund:fetch": "npx --yes tsx scripts/fetch-smallfund-csv.ts",
    "smallfund:import": "npx --yes tsx scripts/import-smallfund-to-db.ts",
    "smallfund:diag": "npx --yes tsx scripts/diagnose-smallfund.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@mantine/core": "^9.4.2",
    "@mantine/hooks": "^9.4.2",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@tabler/icons-react": "^3.45.0",
    "@tailwindcss/postcss": "^4.3.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.42.2",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^1.26.0",
    "next": "^16.2.11",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.11",
    "postcss": "^8.5.22",
    "prisma": "^7.9.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
